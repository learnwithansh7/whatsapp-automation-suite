# ==============================================================================
# WhatsApp Client - Git Ignore Rules
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
build/
out/
.next/

# Environment variables & Secret Keys
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.cert
*.crt

# Database & Infrastructure Bind-Mounts
infra/data/
postgres/
redis/
*.sqlite
*.sqlite-journal
*.db
*.db-journal

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test & Coverage Outputs
coverage/
.vitest-cache/
.nyc_output/

# Editor & IDE Directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo

# OS & File System Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# WhatsApp Baileys Local Auth & Session Dumps
whatsapp-sessions/
auth_info_baileys/
*.auth
*.session

# Local Uploads, Media, Avatars, and Preview Caches
backend/storage/
storage/
tmp/
temp/
