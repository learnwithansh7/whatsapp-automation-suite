# ==============================================================================
# WhatsApp Client - Backend Environment Variables Template
# Copy this file to backend/.env and populate with your own values before starting.
# NEVER commit your actual .env file with real credentials to source control!
# ==============================================================================

# Server Network Configuration
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# PostgreSQL Database Connection URL
# Replace with your local or remote PostgreSQL connection string
DATABASE_URL="postgresql://postgres:your_secure_password@localhost:5432/whatsapp_client?schema=public"

# 32-Byte AES-256-GCM Encryption Key (REQUIRED)
# Used to encrypt Baileys WhatsApp credentials in PostgreSQL
# Generate a new random 32-byte key using Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="your_base64_encoded_32_byte_key_here="

# JWT Secret for dashboard session cookies
JWT_SECRET="your_secure_jwt_secret_min_32_chars_here"

# Authentication Flag
# false = direct local access (recommended for single-user desktop/homelab use)
# true  = dashboard authentication required
AUTH_ENABLED=false

# Redis Queue Connection (Optional - Outbox uses PostgreSQL table by default)
# REDIS_URL="redis://127.0.0.1:6379"

# ------------------------------------------------------------------------------
# Anti-Ban Send Queue & Rate Limits
# ------------------------------------------------------------------------------
# Random jitter delay between consecutive outgoing messages (milliseconds)
SEND_MIN_DELAY_MS=1500
SEND_MAX_DELAY_MS=3500

# Sliding-window rate limit caps to prevent WhatsApp spam bans
SEND_MAX_PER_MINUTE=20
SEND_MAX_PER_HOUR=300

# ------------------------------------------------------------------------------
# Media Upload & Auto-Download Limits (in Megabytes)
# ------------------------------------------------------------------------------
MAX_IMAGE_SIZE_MB=16
MAX_VIDEO_SIZE_MB=64
MAX_DOCUMENT_SIZE_MB=100
MAX_AUDIO_SIZE_MB=16
AUTO_DOWNLOAD_VIDEO_MAX_MB=25

# WhatsApp Read Receipts (Blue Ticks)
# false = reading chats resets unread counters locally without alerting the sender
# true  = sends blue-tick read receipts to WhatsApp servers
SEND_READ_RECEIPTS=false

# Docker Infrastructure Defaults (for docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=whatsapp_client
POSTGRES_PORT=5432
REDIS_PORT=6379
