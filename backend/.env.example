# Server configuration
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:your_secure_password@localhost:5432/whatsapp_client?schema=public"

# 32-byte AES-256-GCM encryption key (REQUIRED)
ENCRYPTION_KEY="your_base64_encoded_32_byte_key_here="

# JWT Secret for authentication cookies
JWT_SECRET="your_secure_jwt_secret_here"

# Authentication flag: false = login bypassed for local development (Supabase auth will replace this later)
AUTH_ENABLED=false

# Redis queue and cache connection (Optional in Phase 0/1; will be required in Phase 3)
# REDIS_URL="redis://127.0.0.1:6379"
