# Server configuration
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:your_secure_password@localhost:5432/whatsapp_client?schema=public"

# 32-byte AES-256-GCM encryption key (REQUIRED)
ENCRYPTION_KEY="your_base64_encoded_32_byte_key_here="

# JWT Secret for authentication cookies
JWT_SECRET="your_secure_jwt_secret_here"

# Authentication flag: false = login bypassed for local development (Supabase auth will replace this later)
AUTH_ENABLED=false

# Redis queue and cache connection (Optional in Phase 0/1; will be required in Phase 3)
# REDIS_URL="redis://127.0.0.1:6379"

# Phase 3: Anti-Ban Send Queue & Rate Limits
SEND_MIN_DELAY_MS=1500
SEND_MAX_DELAY_MS=3500
SEND_MAX_PER_MINUTE=20
SEND_MAX_PER_HOUR=300

# Phase 3: Media Upload & Download Limits (MB)
MAX_IMAGE_SIZE_MB=16
MAX_VIDEO_SIZE_MB=64
MAX_DOCUMENT_SIZE_MB=100
MAX_AUDIO_SIZE_MB=16
AUTO_DOWNLOAD_VIDEO_MAX_MB=25

# Phase 3: WhatsApp Read Receipts (default false = only local unread counter resets)
SEND_READ_RECEIPTS=false
